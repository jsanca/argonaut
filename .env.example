# Argonaut environment configuration template
# Copy to .env and populate before running any service.
# Never commit .env — it is listed in .gitignore.

# OpenRouter credentials
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Service ports (defaults match the project convention)
SPRING_AI_PORT=8081
LANGCHAIN4J_PORT=8082
LANGGRAPH4J_PORT=8083
EMBABEL_PORT=8084
KOOG_PORT=8085

# UI port
ARGONAUT_UI_PORT=8080
